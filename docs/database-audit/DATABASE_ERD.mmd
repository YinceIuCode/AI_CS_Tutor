erDiagram
    %% =========================================================================
    %% OFFBYONE LOGICAL DATA MODEL & ENTITY RELATIONSHIP DIAGRAM (ERD)
    %% Note: Represents the verified logical models implemented in the OffByOne
    %% codebase (Frontend state, Browser LocalStorage/SessionStorage, and Mock Services).
    %% Actual SQL/RDBMS Backend database is currently NOT IMPLEMENTED (0 tables).
    %% =========================================================================

    USER {
        string id PK "Unique identifier (user-uuid or guest-uuid)"
        string fullName "Display name of student"
        string email "Unique email address"
        string role "student | educator | admin"
        string accountType "registered | guest"
        string passwordDigest "DJB2 salt digest (mocked, never plaintext)"
    }

    USER_PROGRESS {
        string userId PK,FK "References USER.id"
        string accountType "registered (localStorage) | guest (sessionStorage)"
        string roadmapFlowState "empty | loading | ready"
        string fileName "Current syllabus filename"
        string fileSize "File size string e.g. 2.4 MB"
        string updatedAt "ISO 8601 timestamp"
    }

    KNOWLEDGE_BASE_DOC {
        string id PK "Document ID e.g. doc-cs101-hcmus"
        string name "Document title / filename"
        string size "File size e.g. 2.4 MB"
        int chunks "Number of text vector chunks (e.g. 48)"
        string status "indexed | processing | error"
        string indexedAt "ISO 8601 timestamp"
    }

    ROADMAP_NODE {
        string id PK "Unique slug e.g. avl-tree, bst"
        string shortCode "Display index e.g. 01, 08"
        string label "Display title e.g. AVL Tree"
        string description "Conceptual overview text"
        string status "completed | current | locked"
        string complexity "Asymptotic bound e.g. O(log N)"
        int progress "Calculated completion percentage (0-100)"
        int totalTasks "Total task count (default 3)"
        int completedTasks "Count of completed tasks"
    }

    NODE_PREREQUISITE {
        string nodeId PK,FK "Target node ID"
        string prerequisiteNodeId PK,FK "Required prerequisite node ID"
    }

    ROADMAP_TASK {
        string id PK "Unique task ID e.g. avl-tree-task-3"
        string nodeId FK "References ROADMAP_NODE.id"
        string title "Task title"
        string description "Short task description"
        string status "completed | current | locked"
        string type "theory | quiz | coding"
    }

    TASK_COMPLETION {
        string userId PK,FK "References USER.id"
        string taskId PK,FK "References ROADMAP_TASK.id"
        boolean isCompleted "True if task is completed"
    }

    QUIZ_PROGRESS {
        string userId PK,FK "References USER.id"
        string taskId PK,FK "References ROADMAP_TASK.id"
        string selectedOption "Selected option ID e.g. A, B, C, D"
        boolean isSubmitted "Whether quiz answer was submitted"
    }

    CODE_DRAFT {
        string userId PK,FK "References USER.id"
        string taskId PK,FK "References ROADMAP_TASK.id"
        string code "Current code buffer in Monaco Editor"
        string language "Language e.g. C++, Python"
        boolean isSubmitted "Whether code was submitted"
    }

    HINT_PROGRESS {
        string userId PK,FK "References USER.id"
        string taskId PK,FK "References ROADMAP_TASK.id"
        int hintsRemaining "Count of remaining hints (default 2)"
    }

    THEORY_CONTENT {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string headerTitle "Header label"
        string moduleLabel "Module tracker e.g. Module 1 of 3:"
        string summaryLead "Overview introduction text"
        string slideLabel "PDF reference label"
    }

    THEORY_CARD {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string badge "Badge e.g. 01, 02"
        string title "Knowledge card title"
        string detail "Explanation paragraph"
    }

    QUIZ_CONTENT {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string question "Question prompt markdown"
        string slideLabel "PDF lecture slide reference"
    }

    QUIZ_OPTION {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string id "Option key: A | B | C | D"
        string text "Option description text"
        boolean isCorrect "True for correct option"
    }

    CODING_TASK_DETAIL {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string nodeId FK "References ROADMAP_NODE.id"
        string fileName "Single file name e.g. solution.cpp"
        string language "Language string e.g. C++"
        string initialCode "Starter code template"
        string slideLabel "PDF lecture slide label"
    }

    PROBLEM_SPEC {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string title "Problem specification title"
        string difficulty "Easy | Medium | Hard"
        string description "Detailed problem statement"
        string inputFormat "Input data format description"
        string outputFormat "Output format description"
        string notes "Special caveats, hints or notes"
    }

    PROBLEM_EXAMPLE {
        string taskId PK,FK "References ROADMAP_TASK.id"
        int exampleIndex "Sequence index: 1, 2, ..."
        string input "Sample input string"
        string output "Expected sample output"
        string explanation "Human-readable explanation"
    }

    PROBLEM_CONSTRAINT {
        string taskId PK,FK "References ROADMAP_TASK.id"
        string constraintText "Boundary constraint e.g. -10^5 <= key <= 10^5"
    }

    EXECUTION_RESULT {
        string action "run | submit"
        string status "success | failed"
        string errorType "Compilation Error | Runtime Error | Wrong Answer | TLE | MLE"
        string errorTitle "Error headline"
        string errorMessage "Detailed error diagnosis"
        string errorAction "Actionable fix recommendation"
        int runtimeMs "Execution latency in milliseconds"
        string memoryMb "Memory footprint e.g. 4.2 MB"
        int passedCount "Number of passed test cases"
        int totalCount "Total evaluated test cases"
        string stdout "Standard output buffer"
    }

    TEST_CASE_RESULT {
        int id "Test case identifier"
        string label "Display label e.g. Test Case #1"
        boolean passed "Whether test passed"
        string input "Input parameter values"
        string expected "Expected return value"
        string actual "Actual returned value / crash"
        string error "Error exception message if any"
    }

    SOCRATIC_PROFILE {
        string nodeId PK,FK "References ROADMAP_NODE.id"
        string topicLabel "Display topic title"
        string ragSourceBadge "RAG citation tag"
    }

    SOCRATIC_TIER {
        string nodeId PK,FK "References ROADMAP_NODE.id"
        string mode "theory | quiz | coding"
        int tier "Progressive tier: 1 | 2 | 3"
        string badge "Badge e.g. Conceptual Probe"
        string color "CSS semantic color token"
        string title "Hint headline"
        string content "Socratic guiding question"
    }

    %% =========================================================================
    %% RELATIONSHIPS
    %% =========================================================================

    USER ||--|| USER_PROGRESS : "owns progress (1:1)"
    USER ||--o{ TASK_COMPLETION : "completes (1:N)"
    USER ||--o{ QUIZ_PROGRESS : "answers (1:N)"
    USER ||--o{ CODE_DRAFT : "edits (1:N)"
    USER ||--o{ HINT_PROGRESS : "tracks hints (1:N)"

    ROADMAP_NODE ||--o{ ROADMAP_TASK : "contains (1:N)"
    ROADMAP_NODE ||--o{ NODE_PREREQUISITE : "requires (1:N)"
    ROADMAP_NODE ||--|| SOCRATIC_PROFILE : "has tutor profile (1:1)"
    SOCRATIC_PROFILE ||--o{ SOCRATIC_TIER : "structures tiers (1:N)"

    ROADMAP_TASK ||--o{ TASK_COMPLETION : "completion record (1:N)"
    ROADMAP_TASK ||--o{ QUIZ_PROGRESS : "quiz draft (1:N)"
    ROADMAP_TASK ||--o{ CODE_DRAFT : "code draft (1:N)"
    ROADMAP_TASK ||--o{ HINT_PROGRESS : "hint count (1:N)"

    ROADMAP_TASK ||--o| THEORY_CONTENT : "theory details (1:0..1)"
    THEORY_CONTENT ||--o{ THEORY_CARD : "theory knowledge cards (1:N)"

    ROADMAP_TASK ||--o| QUIZ_CONTENT : "quiz details (1:0..1)"
    QUIZ_CONTENT ||--o{ QUIZ_OPTION : "quiz options (1:N)"

    ROADMAP_TASK ||--o| CODING_TASK_DETAIL : "coding details (1:0..1)"
    CODING_TASK_DETAIL ||--|| PROBLEM_SPEC : "problem statement (1:1)"
    PROBLEM_SPEC ||--o{ PROBLEM_EXAMPLE : "test examples (1:N)"
    PROBLEM_SPEC ||--o{ PROBLEM_CONSTRAINT : "constraints (1:N)"

    EXECUTION_RESULT ||--o{ TEST_CASE_RESULT : "evaluates (1:N)"
